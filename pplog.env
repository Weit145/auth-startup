# PPLog config
#
# Makes JSON logs from log/slog readable in the terminal.
#
# Links:
#   GitHub:  https://github.com/michurin/human-readable-json-logging
#   Install: go install -v github.com/michurin/human-readable-json-logging/cmd/...@latest
#   Syntax:  systemd env-files
#
# Variables:
#   PPLOG_LOGLINE - template for valid JSON log lines
#   PPLOG_ERRLINE - template for plain text / non-JSON lines
#
# Output shape:
#   15:04:05 INFO  Init logger /path/to/file.go:21 key=value
#
# Colors:
#   time=magenta, DEBUG=blue, INFO=green, WARN=yellow, ERROR=red,
#   message=cyan, source=gray, attrs=yellow/white.

PPLOG_LOGLINE='
{{- if .time }}\e[95m{{ .time | tmf "2006-01-02T15:04:05Z07:00" "15:04:05" }}\e[0m{{ end }}
{{- if .level }} {{ if eq .level "DEBUG" }}\e[94m{{ printf "%-5s" .level }}{{ else if eq .level "INFO" }}\e[92m{{ printf "%-5s" .level }}{{ else if eq .level "WARN" }}\e[1;93m{{ printf "%-5s" .level }}{{ else if eq .level "ERROR" }}\e[1;91m{{ printf "%-5s" .level }}{{ else }}{{ printf "%-5s" .level }}{{ end }}\e[0m{{ end }}
{{- if .msg }} \e[96m{{ .msg }}\e[0m{{ end }}
{{- if .source }} \e[90m{{ .source.file }}:{{ .source.line }}\e[0m{{ end }}
{{- range .ALL | rm "time" "level" "msg" "source" }} \e[93m{{ .K }}\e[0m=\e[97m{{ .V }}\e[0m{{ end }}
'

PPLOG_ERRLINE='\e[7;91m NOJSON \e[0m {{ if .BINARY }}{{ .TEXT }}{{ else }}\e[97m{{ .TEXT }}\e[0m{{ end }}'
